<?xml version="1.0" encoding="utf-8"?>
<UserSettings>
  <ApplicationIdentity version="17.0"/>
  <ToolsOptions>
    <ToolsOptionsCategory name="Environment">
      <ToolsOptionsSubCategory name="ExternalTools">
        <PropertyValue name="ToolNames">📦 版本升级 (Patch)|📈 版本升级 (Minor)|🎯 版本升级 (Major)|🔨 编译并升级版本|🤖 智能版本升级</PropertyValue>
        <PropertyValue name="ToolDirs">$(ProjectDir)|$(ProjectDir)|$(ProjectDir)|$(ProjectDir)|$(ProjectDir)</PropertyValue>
        <PropertyValue name="ToolArgs">-ExecutionPolicy Bypass -File "$(ProjectDir)AutoVersion.ps1" -VersionType patch -Interactive|-ExecutionPolicy Bypass -File "$(ProjectDir)AutoVersion.ps1" -VersionType minor -Interactive|-ExecutionPolicy Bypass -File "$(ProjectDir)AutoVersion.ps1" -VersionType major -Interactive|patch|-ExecutionPolicy Bypass -File "$(ProjectDir)smart-version.ps1" -Interactive</PropertyValue>
        <PropertyValue name="ToolCmds">powershell.exe|powershell.exe|powershell.exe|$(ProjectDir)build-with-version.bat|powershell.exe</PropertyValue>
        <PropertyValue name="ToolOpt">17|17|17|17|17</PropertyValue>
        <PropertyValue name="NumTools">5</PropertyValue>
      </ToolsOptionsSubCategory>
    </ToolsOptionsCategory>
  </ToolsOptions>
  <Category name="Environment" Description="Environment settings.">
    <Category name="Keyboard" Description="Keyboard mappings.">
      <UserShortcuts>
        <RemoveShortcut>VsVim.VsVim</RemoveShortcut>
        <Shortcut Command="Tools.ExternalCommand1" Scope="Global">Ctrl+Shift+V, P</Shortcut>
        <Shortcut Command="Tools.ExternalCommand2" Scope="Global">Ctrl+Shift+V, M</Shortcut>
        <Shortcut Command="Tools.ExternalCommand3" Scope="Global">Ctrl+Shift+V, J</Shortcut>
        <Shortcut Command="Tools.ExternalCommand4" Scope="Global">Ctrl+Shift+B, V</Shortcut>
        <Shortcut Command="Tools.ExternalCommand5" Scope="Global">Ctrl+Shift+V, A</Shortcut>
      </UserShortcuts>
    </Category>
  </Category>
</UserSettings> 