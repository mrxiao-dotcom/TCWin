<Window x:Class="BinanceFuturesTrader.Views.ContractConfigEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑合约配置" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
            <StackPanel>
                <TextBlock Name="TitleTextBlock" Text="编辑合约配置 - BTCUSDT" FontSize="18" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Name="SubtitleTextBlock" Text="当前浮盈: +125.50 USDT" FontSize="14" 
                          HorizontalAlignment="Center" Foreground="Green"/>
            </StackPanel>
        </Border>

        <!-- 配置编辑区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- 保本配置 -->
                <GroupBox Header="💰 保本配置" FontSize="14" FontWeight="Bold" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="保本目标金额：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="BreakEvenTargetTextBox" Text="100.00" 
                                Width="100" HorizontalAlignment="Left" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="USDT" VerticalAlignment="Center" Margin="5,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="保本状态：" VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Name="BreakEvenStatusComboBox" 
                                 Width="100" HorizontalAlignment="Left" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" 
                                  Text="💡 提示：保本目标金额是触发保本止损的浮盈阈值" 
                                  Foreground="Gray" FontSize="12" Margin="0,10,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- 推仓配置 -->
                <GroupBox Header="📈 推仓配置" FontSize="14" FontWeight="Bold" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 表头 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="阶梯" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="触发金额(USDT)" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="状态" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,5"/>
                        
                        <!-- 推仓1档 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="推仓1档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="PushTier1AmountTextBox" Text="50.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" Name="PushTier1StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <!-- 推仓2档 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="推仓2档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="PushTier2AmountTextBox" Text="100.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="2" Grid.Column="2" Name="PushTier2StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <!-- 推仓3档 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="推仓3档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="PushTier3AmountTextBox" Text="150.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="3" Grid.Column="2" Name="PushTier3StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <!-- 推仓4档 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="推仓4档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Name="PushTier4AmountTextBox" Text="200.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="4" Grid.Column="2" Name="PushTier4StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" 
                                  Text="💡 提示：推仓阶梯设置触发加仓的浮盈阈值，触发后会自动加仓并设置保本止损" 
                                  Foreground="Gray" FontSize="12" Margin="0,10,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- 保盈配置 -->
                <GroupBox Header="🛡️ 保盈配置" FontSize="14" FontWeight="Bold" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 表头 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="阶梯" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="触发金额(USDT)" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="状态" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,5"/>
                        
                        <!-- 保盈1档 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="保盈1档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="ProfitTier1AmountTextBox" Text="500.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" Name="ProfitTier1StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <!-- 保盈2档 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="保盈2档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="ProfitTier2AmountTextBox" Text="1000.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="2" Grid.Column="2" Name="ProfitTier2StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <!-- 保盈3档 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="保盈3档" HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="ProfitTier3AmountTextBox" Text="1500.00" 
                                HorizontalAlignment="Center" Width="100" Margin="0,5"/>
                        <ComboBox Grid.Row="3" Grid.Column="2" Name="ProfitTier3StatusComboBox" 
                                 HorizontalAlignment="Center" Width="100" Margin="0,5">
                            <ComboBoxItem Content="未触发" Tag="-"/>
                            <ComboBoxItem Content="已执行" Tag="√"/>
                            <ComboBoxItem Content="执行中" Tag="执行中"/>
                        </ComboBox>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" 
                                  Text="💡 提示：保盈阶梯设置止盈保护的浮盈阈值，触发后会设置保盈止损委托" 
                                  Foreground="Gray" FontSize="12" Margin="0,10,0,0"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="SaveButton" Content="保存配置" Width="100" Height="35" 
                       Background="Green" Foreground="White" FontWeight="Bold" 
                       Click="SaveButton_Click" Margin="0,0,10,0"/>
                <Button Name="ResetButton" Content="重置默认" Width="100" Height="35" 
                       Background="Orange" Foreground="White" FontWeight="Bold" 
                       Click="ResetButton_Click" Margin="0,0,10,0"/>
                <Button Name="CancelButton" Content="取消" Width="100" Height="35" 
                       Background="Gray" Foreground="White" FontWeight="Bold" 
                       Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 