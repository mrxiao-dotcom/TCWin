<Window x:Class="BinanceFuturesTrader.Views.OperationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="操作历史记录" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题和日期选择区 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📖 操作历史记录" FontSize="18" FontWeight="Bold" 
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="选择日期：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker Name="HistoryDatePicker" SelectedDate="{x:Static sys:DateTime.Today}" 
                               Width="120" SelectedDateChanged="HistoryDatePicker_SelectedDateChanged"/>
                </StackPanel>

                <Button Grid.Column="3" Name="RefreshButton" Content="🔄 刷新" Width="80" Height="30" 
                       Background="#4A90E2" Foreground="White" Margin="10,0,0,0"
                       Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- 历史记录列表 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="RecordCountText" Text="今日记录：0 条" 
                          FontWeight="Bold" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto">
                    <DataGrid Name="HistoryDataGrid" AutoGenerateColumns="False" 
                             IsReadOnly="True" GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column" CanUserSortColumns="True"
                             AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding FormattedTime}" Width="80"/>
                            <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="120"/>
                            <DataGridTextColumn Header="合约" Binding="{Binding ContractName}" Width="120"/>
                            <DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding OperationType}" Width="100"/>
                            <DataGridTextColumn Header="用户" Binding="{Binding Username}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部按钮区 -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="ExportButton" Content="📄 导出" Width="80" Height="30" 
                       Background="#28A745" Foreground="White" Margin="0,0,10,0"
                       Click="ExportButton_Click"/>
                <Button Name="CloseButton" Content="关闭" Width="80" Height="30" 
                       Background="Gray" Foreground="White"
                       Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 