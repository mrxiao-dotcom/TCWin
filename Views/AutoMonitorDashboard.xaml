<Window x:Class="BinanceFuturesTrader.Views.AutoMonitorDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="自动盯盘控制面板" 
        Icon="../Icons/app.ico"
        Height="900" Width="1600" 
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏和控制按钮 -->
        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,8" Background="LightBlue">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="自动盯盘控制面板" FontSize="18" FontWeight="Bold" 
                              VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock Text="{Binding StatusText}" 
                              FontSize="12" Foreground="DarkGreen" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ToggleMonitorButton" Content="{Binding ToggleButtonText}" Width="120" Height="32" Margin="0,0,8,0"
                           Background="{Binding ToggleButtonBackground}" Foreground="White" FontWeight="Bold"
                           ToolTip="{Binding ToggleButtonTooltip}" Click="ToggleMonitorButton_Click"
                           IsEnabled="{Binding ToggleButtonEnabled}"/>
                    <Button x:Name="RefreshButton" Content="刷新数据" Width="100" Height="32" Margin="0,0,8,0"
                           Background="SteelBlue" Foreground="White" FontWeight="Bold"
                           ToolTip="刷新监控数据" Click="RefreshButton_Click"/>
                    <Button x:Name="CloseButton" Content="关闭面板" Width="100" Height="32"
                           Background="Gray" Foreground="White" FontWeight="Bold" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- 状态概览 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 运行状态卡片 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,2,0">
                <Border Background="{Binding StatusCardBackground}">
                    <StackPanel Margin="8">
                        <TextBlock Text="运行状态" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{Binding MonitorStatusText}" FontSize="14" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- 合约数量 -->
            <materialDesign:Card Grid.Column="1" Margin="2,0">
                <Border Background="Green">
                    <StackPanel Margin="8">
                        <TextBlock Text="监控合约" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{Binding ContractCount}" FontSize="16" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- 条件统计 -->
            <materialDesign:Card Grid.Column="2" Margin="2,0">
                <Border Background="Orange">
                    <StackPanel Margin="8">
                        <TextBlock Text="触发条件" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{Binding TotalConditionsText}" FontSize="14" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- 执行中条件 -->
            <materialDesign:Card Grid.Column="3" Margin="2,0">
                <Border Background="Blue">
                    <StackPanel Margin="8">
                        <TextBlock Text="执行中" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{Binding ExecutingCount}" FontSize="16" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- 已执行条件 -->
            <materialDesign:Card Grid.Column="4" Margin="2,0,0,0">
                <Border Background="Purple">
                    <StackPanel Margin="8">
                        <TextBlock Text="已执行" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{Binding ExecutedCount}" FontSize="16" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>
        </Grid>

        <!-- 合约监控管理表格 -->
        <materialDesign:Card Grid.Row="2" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="合约触发条件管理" FontSize="16" FontWeight="Bold" 
                          Foreground="DarkBlue" Margin="0,0,0,8"/>
                
                <DataGrid x:Name="ContractMonitorDataGrid" 
                         ItemsSource="{Binding ContractMonitors}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="{Binding IsDataGridReadOnly}"
                         SelectionMode="Single"
                         GridLinesVisibility="All"
                         BorderThickness="1"
                         BorderBrush="DarkBlue"
                         FontSize="11"
                         RowHeight="35"
                         HeadersVisibility="All"
                         AlternatingRowBackground="Wheat"
                         Background="White"
                         MouseDoubleClick="ContractMonitorDataGrid_MouseDoubleClick">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="DarkBlue"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- 启用/禁用 -->
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- 合约信息 -->
                        <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="DarkBlue"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="方向" Binding="{Binding PositionSide}" Width="60" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="DarkBlue"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 状态列已移除 - 使用图形化状态显示 -->

                        <!-- 价格信息 -->
                        <DataGridTextColumn Header="当前价" Binding="{Binding CurrentPriceText}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="DarkGreen"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="持仓量" Binding="{Binding PositionSizeText}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="DarkGreen"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="浮盈" Binding="{Binding PnlText}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{Binding PnlColor}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 保本状态 - 改为图标显示 -->
                        <DataGridTemplateColumn Header="保本状态" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BreakEvenProgressColor}" 
                                           CornerRadius="3" Padding="5,2" Margin="2">
                                        <TextBlock Text="{Binding TriggerConditions[0].StatusIcon}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  FontFamily="Consolas" 
                                                  FontSize="12"
                                                  Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 推仓进度 - 改为图标显示 -->
                        <DataGridTemplateColumn Header="推仓进度" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AddPositionProgressColor}" 
                                           CornerRadius="3" Padding="5,2" Margin="2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- 显示推仓状态图标 -->
                                            <TextBlock Text="{Binding AddPositionProgressIcon}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      FontFamily="Consolas" 
                                                      FontSize="10"
                                                      Foreground="White"
                                                      Margin="0,0,3,0"/>
                                            <!-- 显示进度数字 -->
                                            <TextBlock Text="{Binding AddPositionProgressText}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      FontFamily="Consolas" 
                                                      FontSize="9"
                                                      Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 止盈进度 - 改为图标显示 -->
                        <DataGridTemplateColumn Header="止盈进度" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ProfitProgressColor}" 
                                           CornerRadius="3" Padding="5,2" Margin="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- 显示止盈状态图标 -->
                                            <TextBlock Text="{Binding ProfitProgressIcon}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      FontFamily="Consolas" 
                                                      FontSize="10"
                                                      Foreground="White"
                                                      Margin="0,0,3,0"/>
                                            <!-- 显示进度数字 -->
                                            <TextBlock Text="{Binding ProfitProgressText}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      FontFamily="Consolas" 
                                                      FontSize="9"
                                                      Foreground="White"/>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>

        <!-- 底部操作区域 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 快速操作按钮 -->
            <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="加载配置" Width="120" Height="36" Margin="0,0,8,0"
                       Background="Purple" Foreground="White" FontWeight="Bold" FontSize="12"
                       IsEnabled="{Binding EditButtonEnabled}"
                       ToolTip="从自动盯盘配置文件加载合约和条件" Click="LoadFromConfigButton_Click"/>
                <Button Content="更新配置" Width="120" Height="36" Margin="0,0,8,0"
                       Background="Green" Foreground="White" FontWeight="Bold" FontSize="12"
                       ToolTip="更新当前条件和状态到本地配置文件" Click="SaveConfigButton_Click"/>
                <Button Content="全部重置" Width="120" Height="36" Margin="0,0,8,0"
                       Background="Red" Foreground="White" FontWeight="Bold" FontSize="12"
                       IsEnabled="{Binding EditButtonEnabled}"
                       ToolTip="重置所有合约的所有状态" Click="ResetAllButton_Click"/>
                <Button Content="执行历史" Width="120" Height="36" Margin="0,0,8,0"
                       Background="SteelBlue" Foreground="White" FontWeight="Bold" FontSize="12"
                       ToolTip="查看执行历史记录" Click="ViewHistoryButton_Click"/>
            </WrapPanel>

            <!-- 状态信息 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="最后更新: " FontSize="12" Foreground="DarkBlue" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastUpdateTime, StringFormat={}{0:HH:mm:ss}}" 
                          FontSize="12" Foreground="DarkBlue" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock Text="扫描间隔: " FontSize="12" Foreground="DarkBlue" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ScanIntervalText}" 
                          FontSize="12" Foreground="DarkBlue" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window> 