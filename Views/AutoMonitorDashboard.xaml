<Window x:Class="BinanceFuturesTrader.Views.AutoMonitorDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🔍 自动盯盘监控面板" 
        Icon="../Icons/app.ico"
        Height="900" Width="1400" 
        MinHeight="800" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏和刷新按钮 -->
        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,8" Background="LightBlue">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MonitorDashboard" Width="24" Height="24" 
                                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="DarkBlue"/>
                    <TextBlock Text="自动盯盘监控面板" FontSize="18" FontWeight="Bold" 
                              VerticalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock Text="{Binding LastUpdateTime, StringFormat=最后更新: {0:HH:mm:ss}}" 
                              FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="🔄 刷新" Width="80" Height="32" Margin="0,0,8,0"
                           Background="Green" Foreground="White" FontWeight="Bold"
                           ToolTip="手动刷新监控数据" Click="RefreshButton_Click"/>
                    <Button x:Name="CloseButton" Content="❌ 关闭" Width="80" Height="32"
                           Background="Red" Foreground="White" FontWeight="Bold" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- 监控状态概览区域 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- 状态统计卡片 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 运行状态卡片 -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,4,0">
                    <Border Background="{Binding StatusCardBackground}">
                        <StackPanel Margin="8">
                            <TextBlock Text="运行状态" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorStatus}" FontSize="14" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="{Binding StatusTextColor}"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>

                <!-- 活跃合约卡片 -->
                <materialDesign:Card Grid.Column="1" Margin="2,0">
                    <Border Background="LightGreen">
                        <StackPanel Margin="8">
                            <TextBlock Text="活跃合约" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveContractCount}" FontSize="16" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="DarkGreen"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>

                <!-- 执行统计卡片 -->
                <materialDesign:Card Grid.Column="2" Margin="2,0">
                    <Border Background="LightCoral">
                        <StackPanel Margin="8">
                            <TextBlock Text="执行统计" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalExecutions}" FontSize="16" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="DarkRed"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>

                <!-- 止损单状态卡片 -->
                <materialDesign:Card Grid.Column="3" Margin="2,0,0,0">
                    <Border Background="LightSteelBlue">
                        <StackPanel Margin="8">
                            <TextBlock Text="止损单管理" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveStopOrderCount}" FontSize="16" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="SteelBlue"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
            </Grid>
            
            <!-- 🔧 详细的盯盘配置信息区域 -->
            <materialDesign:Card Padding="16" Background="#e8f4f8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="⚙️ 当前盯盘配置详情" FontSize="16" FontWeight="Bold" 
                                  Foreground="DarkBlue" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="配置名称: " FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConfigName}" FontSize="12" FontWeight="Bold" 
                                      Foreground="DarkBlue" VerticalAlignment="Center" Margin="4,0,16,0"/>
                            <TextBlock Text="扫描间隔: " FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScanIntervalDisplay}" FontSize="12" FontWeight="Bold" 
                                      Foreground="DarkSlateGray" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 保本配置 -->
                        <materialDesign:Card Grid.Column="0" Padding="12" Margin="0,0,8,0" Background="LightGreen">
                            <StackPanel>
                                <TextBlock Text="🛡️ 保本配置" FontSize="13" FontWeight="Bold" 
                                          Foreground="DarkGreen" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding BreakEvenConfigDisplay}" FontSize="12" FontWeight="Bold" 
                                          Foreground="DarkGreen" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </materialDesign:Card>
                        
                        <!-- 推仓配置详情 -->
                        <materialDesign:Card Grid.Column="1" Padding="12" Margin="8,0" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="⚡ 推仓配置详情" FontSize="13" FontWeight="Bold" 
                                          Foreground="#495057" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding AddPositionTiers}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         IsReadOnly="True"
                                         GridLinesVisibility="Horizontal"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="11"
                                         RowHeight="32"
                                         HeadersVisibility="Column"
                                         AlternatingRowBackground="#f1f3f4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="档位" Binding="{Binding TierIndex}" Width="0.8*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#495057"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="触发浮盈" Width="1.3*">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="TriggerProfitAmount" StringFormat="{}{0:F0}U"/>
                                            </DataGridTextColumn.Binding>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#28a745"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="风险倍数" Width="1.2*">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="RiskMultiplier" StringFormat="{}{0:F1}倍"/>
                                            </DataGridTextColumn.Binding>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#007bff"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="止损比例" Width="1.2*">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="StopLossRatio" StringFormat="{}{0:P1}"/>
                                            </DataGridTextColumn.Binding>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#dc3545"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                        
                        <!-- 保盈配置详情 -->
                        <materialDesign:Card Grid.Column="2" Padding="12" Margin="8,0,0,0" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="💰 保盈配置详情" FontSize="13" FontWeight="Bold" 
                                          Foreground="#495057" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding ProfitProtectionTiers}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         IsReadOnly="True"
                                         GridLinesVisibility="Horizontal"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="11"
                                         RowHeight="32"
                                         HeadersVisibility="Column"
                                         AlternatingRowBackground="#f1f3f4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="档位" Binding="{Binding TierIndex}" Width="0.8*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#495057"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="触发浮盈" Width="1.5*">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="TriggerProfitAmount" StringFormat="{}{0:F0}U"/>
                                            </DataGridTextColumn.Binding>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#28a745"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="保护金额" Width="1.5*">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="ProtectionAmount" StringFormat="{}{0:F0}U"/>
                                            </DataGridTextColumn.Binding>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#6f42c1"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 🔧 改进的合约状态表格 -->
            <materialDesign:Card Grid.Column="0" Padding="8" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📊 合约执行状态详情" FontWeight="Bold" FontSize="14" 
                              Foreground="DarkBlue" Margin="0,0,0,8"/>
                    
                    <DataGrid ItemsSource="{Binding ContractStates}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#f9f9f9"
                             FontSize="13"
                             RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="110" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="保本状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BreakEvenStatusColor}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding BreakEvenStatus}" 
                                                      Foreground="White" FontWeight="Bold" 
                                                      HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="推仓进度" Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="AddPositionProgressDisplay"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="DarkOrange"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="保盈进度" Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ProfitProtectionProgressDisplay"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="DarkMagenta"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="总执行次数" Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="TotalExecutions"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="DarkGreen"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="最后执行" Width="90">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="LastExecutionTime" StringFormat="{}{0:MM-dd HH:mm}"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>

            <!-- 🔧 改进的执行历史 -->
            <materialDesign:Card Grid.Column="1" Padding="8" Margin="4,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📈 最近执行历史" FontWeight="Bold" FontSize="14" 
                              Foreground="DarkGreen" Margin="0,0,0,8"/>
                    
                    <DataGrid ItemsSource="{Binding ExecutionHistory}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#f0f8f0"
                             FontSize="12"
                             RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Width="65">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ExecutionTime" StringFormat="{}{0:HH:mm:ss}"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="70" FontWeight="Bold"/>
                            <DataGridTextColumn Header="类型" Width="65">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ExecutionType"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="结果" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ResultColor}" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding ResultText}" 
                                                      Foreground="White" FontWeight="Bold" 
                                                      HorizontalAlignment="Center" FontSize="10"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="浮盈" Width="50">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="TriggerPnl" StringFormat="{}{0:F1}U"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="DarkBlue"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window> 