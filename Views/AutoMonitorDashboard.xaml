<Window x:Class="BinanceFuturesTrader.Views.AutoMonitorDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="自动盯盘监控面板" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner" 
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        MinWidth="800" MinHeight="600">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部状态栏 -->
        <Grid Grid.Row="0" Background="#2C3E50" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 标题和状态 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,10">
                <TextBlock Text="📊 自动盯盘监控" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Border x:Name="StatusIndicator" Background="#E74C3C" CornerRadius="50" Width="12" Height="12" Margin="15,0,0,0"/>
                <TextBlock x:Name="StatusTextBlock" Text="已停止" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            
            <!-- 统计信息 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <TextBlock Text="活跃合约: " FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActiveContractsText" Text="0" FontSize="12" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  |  总盈亏: " FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="TotalProfitText" Text="0.00 USDT" FontSize="12" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  |  运行时间: " FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="RunningTimeText" Text="00:00:00" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- 控制按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,10">
                <Button x:Name="StartStopButton" Content="🚀 启动监控" Width="100" Height="30" 
                        FontSize="12" FontWeight="Bold" Background="#27AE60" Foreground="White"
                        Click="StartStopButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="RefreshButton" Content="🔄 刷新" Width="60" Height="30" 
                        FontSize="12" Background="#3498DB" Foreground="White"
                        Click="RefreshButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="ConfigButton" Content="⚙️ 配置" Width="60" Height="30" 
                        FontSize="12" Background="#95A5A6" Foreground="White"
                        Click="ConfigButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="ConfigManageButton" Content="📝 管理" Width="60" Height="30" 
                        FontSize="11" Background="#9B59B6" Foreground="White"
                        Click="ConfigManageButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="ComprehensiveLogButton" Content="📊 日志" Width="60" Height="30" 
                        FontSize="11" Background="#E67E22" Foreground="White"
                        Click="ComprehensiveLogButton_Click" ToolTip="打开全面日志查看器"/>
            </StackPanel>
        </Grid>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="10,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            
            <!-- 合约配置表格 -->
            <GroupBox Grid.Row="0" Header="📋 合约配置监控" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 表格工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="合约列表" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ContractCountText" Text="（0个合约）" FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button x:Name="AddContractButton" Content="➕ 添加合约" Width="80" Height="25" 
                                FontSize="10" Background="#4A90E2" Foreground="White"
                                Click="AddContractButton_Click" Margin="20,0,0,0"/>
                        <Button x:Name="RemoveContractButton" Content="➖ 移除合约" Width="80" Height="25" 
                                FontSize="10" Background="#E74C3C" Foreground="White"
                                Click="RemoveContractButton_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    
                    <!-- 合约配置表格 -->
                    <DataGrid Grid.Row="1" x:Name="ContractConfigDataGrid" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="All" HeadersVisibility="All" FontSize="10"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              SelectionMode="Single" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="80"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding PositionSide}" Width="60"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding CurrentPositionAmt, StringFormat=F4}" Width="80"/>
                            <DataGridTextColumn Header="开仓价" Binding="{Binding CurrentEntryPrice, StringFormat=F4}" Width="80"/>
                            <DataGridTextColumn Header="标记价" Binding="{Binding CurrentMarkPrice, StringFormat=F4}" Width="80"/>
                            <DataGridTextColumn Header="未实现盈亏" Binding="{Binding CurrentUnrealizedProfit, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="保本状态" Binding="{Binding BreakEvenStatusDisplay}" Width="80"/>
                            <DataGridTextColumn Header="推仓阶梯" Binding="{Binding AddPositionConfig.Tiers.Count, StringFormat={}{0}个}" Width="80"/>
                            <DataGridTextColumn Header="保盈阶梯" Binding="{Binding ProfitProtectionConfig.Tiers.Count, StringFormat={}{0}个}" Width="80"/>
                            <DataGridTextColumn Header="最后更新" Binding="{Binding LastUpdateTime, StringFormat=HH:mm:ss}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- 分隔线 -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>
            
            <!-- 日志区域 -->
            <GroupBox Grid.Row="2" Header="📝 执行日志" Margin="0,10,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 日志工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="实时日志" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AutoScrollCheckBox" Content="自动滚动" IsChecked="True" 
                                  VerticalAlignment="Center" Margin="20,0,0,0" FontSize="11"/>
                        <Button x:Name="ClearLogButton" Content="🗑️ 清空日志" Width="70" Height="25" 
                                FontSize="10" Background="#E74C3C" Foreground="White"
                                Click="ClearLogButton_Click" Margin="20,0,0,0"/>
                        <Button x:Name="ExportLogButton" Content="📤 导出日志" Width="70" Height="25" 
                                FontSize="10" Background="#95A5A6" Foreground="White"
                                Click="ExportLogButton_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    
                    <!-- 日志显示区域 -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" 
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="Black" Padding="10">
                        <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="11" 
                                   Foreground="Lime" TextWrapping="Wrap"
                                   Text="[系统] 自动盯盘监控面板已启动，等待开始监控..."/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>
        
        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#34495E" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪" FontSize="11" Foreground="White"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusBarTime" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat=yyyy-MM-dd HH:mm:ss}" 
                           FontSize="11" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
