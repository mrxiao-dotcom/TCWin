<Window x:Class="BinanceFuturesTrader.Views.AutoMonitorConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="自动盯盘配置" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" 
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="自动盯盘配置" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <!-- 主配置区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- 基础设置 -->
                <GroupBox Header="基础设置" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 🎯 新增：配置模板选择 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="配置模板:" VerticalAlignment="Center" Margin="0,5" FontWeight="Bold"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <ComboBox x:Name="TemplateComboBox" Width="150" Height="30" FontSize="12"
                                      SelectionChanged="TemplateComboBox_SelectionChanged">
                                <ComboBoxItem Content="🛡️ 保守型（新手推荐）" Tag="Conservative"/>
                                <ComboBoxItem Content="⚖️ 平衡型（推荐）" Tag="Balanced" IsSelected="True"/>
                                <ComboBoxItem Content="🚀 激进型（高风险）" Tag="Aggressive"/>
                                <ComboBoxItem Content="🔧 自定义" Tag="Custom"/>
                            </ComboBox>
                            <Button x:Name="LoadTemplateButton" Content="🔄 应用模板" Width="100" Height="30" 
                                    Margin="10,0,0,0" FontSize="11" Background="#2ECC71" Foreground="White"
                                    Click="LoadTemplateButton_Click" ToolTip="将选择的模板参数应用到当前配置"/>
                        </StackPanel>
                        
                        <!-- 🔍 模板说明 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模板说明:" VerticalAlignment="Top" Margin="0,5" FontSize="11" Foreground="Gray"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TemplateDescriptionText" Margin="5" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="平衡型配置适合有一定经验的用户，在风险可控的前提下追求合理收益。"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="配置名称:" VerticalAlignment="Center" Margin="0,10,0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ConfigNameTextBox" Text="平衡型配置" 
                                 Width="200" HorizontalAlignment="Left" Margin="5,10,0,5"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="扫描间隔:" VerticalAlignment="Center" Margin="0,5"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBox x:Name="ScanIntervalTextBox" Text="30" Width="60"/>
                            <TextBlock Text="秒 (建议30-60秒)" VerticalAlignment="Center" Margin="5,0" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
                
                <!-- 自动保本设置 -->
                <GroupBox Header="1. 自动保本设置" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="BreakEvenEnabledCheckBox" Content="启用自动保本" FontWeight="Bold" Margin="0,5"/>
                        
                        <Grid Margin="20,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="触发盈利值:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="BreakEvenTriggerTextBox" Text="10" Width="80"/>
                                <TextBlock Text="USDT" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Text="（当浮盈达到此值时自动设置保本止损）" 
                                          VerticalAlignment="Center" Margin="10,0" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                
                <!-- 自动推仓设置 -->
                <GroupBox Header="2. 自动推仓设置（一键保本加仓）" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="AddPositionEnabledCheckBox" Content="启用自动推仓" FontWeight="Bold" Margin="0,5"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                            <TextBlock Text="推仓阶梯配置：" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AddPositionStageCountText" Text="（4个阶梯）" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                        
                        <!-- 推仓阶梯表格 -->
                        <DataGrid x:Name="AddPositionDataGrid" Height="180" Margin="0,10" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="All" HeadersVisibility="All" FontSize="11"
                                  HorizontalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="阶梯" Binding="{Binding Stage}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="触发盈利值(USDT)" Binding="{Binding TriggerProfitAmount}" Width="120"/>
                                <DataGridTextColumn Header="风险金倍数" Binding="{Binding RiskCapitalMultiplier}" Width="100"/>
                                <DataGridTextColumn Header="止损比例(%)" Binding="{Binding StopLossPercentage}" Width="100"/>
                                <DataGridTextColumn Header="保盈金额(USDT)" Binding="{Binding ProfitProtectionAmount}" Width="110"/>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="60"/>
                                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- 添加推仓阶梯按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Button x:Name="AddPositionStageButton" Content="+ 增加推仓阶梯" 
                                    Width="120" Height="30" FontSize="12" 
                                    Background="#4A90E2" Foreground="White"
                                    Click="AddPositionStageButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="RemovePositionStageButton" Content="- 删除最后阶梯" 
                                    Width="120" Height="30" FontSize="12" 
                                    Background="#E74C3C" Foreground="White"
                                    Click="RemovePositionStageButton_Click"/>
                        </StackPanel>
                        
                        <TextBlock Text="说明：当浮盈达到对应阶梯的触发值时，自动执行一键保本加仓操作" 
                                   Margin="0,5" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- 自动保盈止损设置 -->
                <GroupBox Header="3. 自动保盈止损设置" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="ProfitProtectionEnabledCheckBox" Content="启用自动保盈止损" FontWeight="Bold" Margin="0,5"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                            <TextBlock Text="保盈止损阶梯配置：" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProfitProtectionStageCountText" Text="（3个阶梯）" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                        
                        <!-- 保盈止损阶梯表格 -->
                        <DataGrid x:Name="ProfitProtectionDataGrid" Height="140" Margin="0,10" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="All" HeadersVisibility="All" FontSize="11"
                                  HorizontalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="阶梯" Binding="{Binding Stage}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="触发盈利值(USDT)" Binding="{Binding TriggerProfitAmount}" Width="120"/>
                                <DataGridTextColumn Header="保护金额(USDT)" Binding="{Binding ProtectionAmount}" Width="120"/>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="60"/>
                                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- 添加保盈止损阶梯按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Button x:Name="ProfitProtectionStageButton" Content="+ 增加止盈阶梯" 
                                    Width="120" Height="30" FontSize="12" 
                                    Background="#4A90E2" Foreground="White"
                                    Click="ProfitProtectionStageButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="RemoveProfitProtectionStageButton" Content="- 删除最后阶梯" 
                                    Width="120" Height="30" FontSize="12" 
                                    Background="#E74C3C" Foreground="White"
                                    Click="RemoveProfitProtectionStageButton_Click"/>
                        </StackPanel>
                        
                        <TextBlock Text="说明：当浮盈达到对应阶梯的触发值时，自动设置保盈止损保护已获得的利润" 
                                   Margin="0,5" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="ConfirmButton" Content="🔄 更新配置" Width="100" Height="35" 
                    FontSize="14" FontWeight="Bold" Background="#4A90E2" Foreground="White"
                    Click="ConfirmButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="35" 
                    FontSize="14" Background="Gray" Foreground="White"
                    Click="CancelButton_Click"/>
        </StackPanel>
        
    </Grid>
</Window> 