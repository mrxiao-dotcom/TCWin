    /// <summary>
    /// 状态到图标颜色转换器 - 支持所有执行状态
    /// </summary>
    public class StatusToIconColorConverter : IValueConverter
    {
        public object Convert(object value, Type targetType, object parameter, System.Globalization.CultureInfo culture)
        {
            if (value is TriggerExecutionStatus status)
            {
                switch (status)
                {
                    case TriggerExecutionStatus.NotTriggered:
                        return new SolidColorBrush(Colors.Gray);   // 未触发 - 灰色
                    case TriggerExecutionStatus.Executing:
                        return new SolidColorBrush(Colors.Orange); // 执行中 - 橙色  
                    case TriggerExecutionStatus.Executed:
                        return new SolidColorBrush(Colors.Green);  // 已执行 - 绿色
                    default:
                        return new SolidColorBrush(Colors.Gray);   // 默认 - 灰色
                }
            }
            return new SolidColorBrush(Colors.Gray);
        }

        public object ConvertBack(object value, Type targetType, object parameter, System.Globalization.CultureInfo culture)
        {
            throw new NotImplementedException();
        }
    }

    /// <summary>
    /// 持仓变化事件处理器 - 监听新开仓并自动添加配置
    /// </summary>
    public class PositionChangeEventHandler : IEventHandler<PositionChangedEvent>
    {
        private readonly AutoMonitorDashboard _dashboard;
        private readonly ILogger _logger;

        public PositionChangeEventHandler(AutoMonitorDashboard dashboard, ILogger logger)
        {
            _dashboard = dashboard ?? throw new ArgumentNullException(nameof(dashboard));
            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
        }

        public Task HandleAsync(PositionChangedEvent eventData, CancellationToken cancellationToken = default)
        {
            try
            {
                // 🔧 修复：增强持仓变化处理，确保实时响应
                if (eventData.ChangeType == PositionChangeType.Opened)
                {
                    _logger.LogInformation($"🆕 检测到新开仓: {eventData.Symbol}_{eventData.PositionSide}, 立即添加监控配置");
                    
                    // 在UI线程中立即执行配置添加
                    System.Windows.Application.Current?.Dispatcher.Invoke(() =>
                    {
                        _dashboard.HandleNewPositionOpened(eventData.Symbol, eventData.PositionSide, eventData.CurrentQuantity, eventData.CurrentPnl);
                        // 立即强制刷新所有持仓数据，确保显示最新状态
                        _dashboard.ForceRefreshPositionsData();
                    });
                }
                else if (eventData.ChangeType == PositionChangeType.Closed)
                {
                    _logger.LogInformation($"❌ 检测到平仓: {eventData.Symbol}_{eventData.PositionSide}, 立即移除监控配置");
                    
                    // 在UI线程中立即执行配置移除
                    System.Windows.Application.Current?.Dispatcher.Invoke(() =>
                    {
                        _dashboard.HandlePositionClosed(eventData.Symbol, eventData.PositionSide);
                        // 立即强制刷新所有持仓数据，确保显示最新状态
                        _dashboard.ForceRefreshPositionsData();
                    });
                }
                else if (eventData.ChangeType == PositionChangeType.Updated)
                {
                    _logger.LogInformation($"🔄 检测到持仓变化: {eventData.Symbol}_{eventData.PositionSide}, 更新数量: {eventData.CurrentQuantity}");
                    
                    // 在UI线程中更新持仓信息
                    System.Windows.Application.Current?.Dispatcher.BeginInvoke(() =>
                    {
                        _dashboard.ForceRefreshPositionsData();
                    });
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"❌ 处理持仓变化事件失败: {eventData.Symbol}_{eventData.PositionSide}");
            }

            return Task.CompletedTask;
        }
    }

    /// <summary>
    /// 执行状态变化事件处理器 - 监听条件触发并立即更新UI状态
    /// </summary>
    public class ExecutionStateChangeEventHandler : IEventHandler<ExecutionStateChangedEvent>
    {
        private readonly AutoMonitorDashboard _dashboard;
        private readonly ILogger _logger;

        public ExecutionStateChangeEventHandler(AutoMonitorDashboard dashboard, ILogger logger)
        {
            _dashboard = dashboard ?? throw new ArgumentNullException(nameof(dashboard));
            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
        }

        public Task HandleAsync(ExecutionStateChangedEvent eventData, CancellationToken cancellationToken = default)
        {
            try
            {
                _logger.LogInformation($"🔄 接收到执行状态变化事件: {eventData.Symbol}_{eventData.PositionSide} {eventData.ExecutionType}" +
                    $"{(eventData.TierIndex.HasValue ? $"阶梯{eventData.TierIndex}" : "")} - {(eventData.IsSuccess ? "成功" : "失败")}");

                // 在UI线程中立即更新对应合约的状态
                System.Windows.Application.Current?.Dispatcher.Invoke(() =>
                {
                    _dashboard.UpdateContractExecutionState(eventData.Symbol, eventData.PositionSide, 
                        eventData.ExecutionType, eventData.TierIndex, eventData.IsSuccess, eventData.Message);
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"❌ 处理执行状态变化事件失败: {eventData.Symbol}_{eventData.PositionSide}");
            }

            return Task.CompletedTask;
        }
    }

    /// <summary>
    /// AutoMonitorDashboard 类的额外方法 - Phase 8 日志增强
    /// </summary>
    public partial class AutoMonitorDashboard
    {
        /// <summary>
        /// 根据消息内容确定日志级别
        /// </summary>
        private Services.LogLevel DetermineLogLevel(string message)
        {
            if (message.Contains("❌") || message.Contains("异常") || message.Contains("失败") || message.Contains("错误"))
                return Services.LogLevel.Error;
            if (message.Contains("⚠️") || message.Contains("警告"))
                return Services.LogLevel.Warning;
            if (message.Contains("🔍") || message.Contains("调试"))
                return Services.LogLevel.Debug;
            return Services.LogLevel.Info;
        }

        /// <summary>
        /// 根据消息内容确定日志类别
        /// </summary>
        private string DetermineLogCategory(string message)
        {
            if (message.Contains("🎯") || message.Contains("执行") || message.Contains("触发") || 
                message.Contains("保本") || message.Contains("推仓") || message.Contains("止盈"))
                return "执行历史";
            if (message.Contains("🔄") || message.Contains("状态") || message.Contains("启动") || 
                message.Contains("停止") || message.Contains("监控"))
                return "状态变化";
            if (message.Contains("🆕") || message.Contains("开仓") || message.Contains("平仓") || 
                message.Contains("持仓") || message.Contains("自动添加"))
                return "用户操作";
            return "系统事件";
        }

        /// <summary>
        /// 解析执行历史信息
        /// </summary>
        private ExecutionInfo? ParseExecutionInfo(string message)
        {
            try
            {
                // 尝试解析格式如: "🎯 执行历史: ✅ BTCUSDT_LONG 保本止损 (浮盈: 123.45U)"
                var patterns = new[]
                {
                    @"(?<symbol>\w+)_(?<side>LONG|SHORT)\s+(?<type>[^(]+)\s*\(浮盈:\s*(?<pnl>[\d.-]+)U\)",
                    @"(?<symbol>\w+)_(?<side>LONG|SHORT)\s+(?<type>.+)",
                    @"实时更新:\s*(?<symbol>\w+)_(?<side>LONG|SHORT)\s+(?<type>[^→]+)"
                };

                foreach (var pattern in patterns)
                {
                    var match = System.Text.RegularExpressions.Regex.Match(message, pattern);
                    if (match.Success)
                    {
                        var symbol = match.Groups["symbol"].Value;
                        var side = match.Groups["side"].Value;
                        var type = match.Groups["type"].Value.Trim();
                        var isSuccess = message.Contains("✅");
                        decimal pnl = 0;
                        
                        if (match.Groups["pnl"].Success)
                        {
                            decimal.TryParse(match.Groups["pnl"].Value, out pnl);
                        }

                        return new ExecutionInfo
                        {
                            Symbol = symbol,
                            PositionSide = side,
                            ExecutionType = type,
                            IsSuccess = isSuccess,
                            TriggerPnl = pnl
                        };
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogDebug(ex, "解析执行信息失败: {Message}", message);
            }
            
            return null;
        }

        /// <summary>
        /// 执行信息结构
        /// </summary>
        private class ExecutionInfo
        {
            public string Symbol { get; set; } = "";
            public string PositionSide { get; set; } = "";
            public string ExecutionType { get; set; } = "";
            public bool IsSuccess { get; set; }
            public decimal TriggerPnl { get; set; }
        }

        /// <summary>
        /// 增强的日志记录到综合日志服务
        /// </summary>
        private void LogToComprehensiveService(string message)
        {
            if (_comprehensiveLoggingService == null) return;

            // 分析消息类型和级别
            var logLevel = DetermineLogLevel(message);
            var category = DetermineLogCategory(message);
            
            // 异步记录到综合日志服务（不阻塞UI）
            _ = Task.Run(async () =>
            {
                try
                {
                    if (category == "执行历史")
                    {
                        // 尝试解析执行历史信息
                        var executionInfo = ParseExecutionInfo(message);
                        if (executionInfo != null)
                        {
                            await _comprehensiveLoggingService.LogExecutionHistoryAsync(
                                executionInfo.Symbol,
                                executionInfo.PositionSide,
                                executionInfo.ExecutionType,
                                executionInfo.IsSuccess,
                                executionInfo.TriggerPnl,
                                message);
                        }
                        else
                        {
                            await _comprehensiveLoggingService.LogSystemEventAsync(
                                "MonitoringDashboard", 
                                "ExecutionLog", 
                                message, 
                                logLevel);
                        }
                    }
                    else if (category == "状态变化")
                    {
                        await _comprehensiveLoggingService.LogMonitorStatusChangeAsync(
                            "DashboardStatus",
                            "运行中",
                            "更新",
                            message);
                    }
                    else if (category == "用户操作")
                    {
                        await _comprehensiveLoggingService.LogUserOperationAsync(
                            "DashboardOperation",
                            message,
                            "AutoMonitorDashboard");
                    }
                    else
                    {
                        await _comprehensiveLoggingService.LogSystemEventAsync(
                            "MonitoringDashboard", 
                            "UserInterface", 
                            message, 
                            logLevel);
                    }
                }
                catch (Exception logEx)
                {
                    _logger.LogError(logEx, "❌ 记录到综合日志服务失败: {Message}", message);
                }
            });
        }

        /// <summary>
        /// 核心日志追加方法 - 同时更新UI和记录到文件
        /// </summary>
        private void AppendLogCore(string message)
        {
            try
            {
                lock (_logLock)
                {
                    var timestamp = DateTime.Now.ToString("HH:mm:ss");
                    var logEntry = $"[{timestamp}] {message}\n";
                    
                    // 🔧 保持向后兼容：继续更新RealTimeLog属性
                    // 限制日志长度，保留最新的1000行
                    var lines = RealTimeLog.Split('\n');
                    if (lines.Length > 1000)
                    {
                        var recentLines = lines.Skip(lines.Length - 800).ToArray();
                        RealTimeLog = string.Join("\n", recentLines);
                    }
                    
                    RealTimeLog += logEntry;
                    
                    // 🔧 Phase 8: 同时记录到全面日志管理服务
                    LogToComprehensiveService(message);
                    
                    // 自动滚动到底部
                    if (_autoScroll)
                    {
                        Application.Current.Dispatcher.BeginInvoke(() =>
                        {
                            try
                            {
                                // 尝试找到日志滚动视图并滚动到底部
                                var logScrollViewer = this.FindName("LogScrollViewer") as System.Windows.Controls.ScrollViewer;
                                if (logScrollViewer != null)
                                {
                                    logScrollViewer.ScrollToEnd();
                                }
                            }
                            catch (Exception ex)
                            {
                                _logger.LogError(ex, "自动滚动日志时发生错误");
                            }
                        });
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "追加日志时发生错误");
            }
        }
    }

    /// <summary>
    /// AutoMonitorDashboard 类的额外方法 - Phase 8 原有方法
    /// </summary>
    public partial class AutoMonitorDashboard
    {
        /// <summary>
        /// 全面日志查看器按钮点击事件 - Phase 8
        /// </summary>
        private void ComprehensiveLogButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                _logger.LogInformation("📊 用户点击全面日志查看器按钮");
                
                if (_comprehensiveLoggingService != null)
                {
                    // 记录按钮点击
                    _ = _comprehensiveLoggingService.LogButtonClickAsync("全面日志查看器", "AutoMonitorDashboard");
                    
                    // 创建并显示全面日志查看器窗口
                    var logViewerWindow = new ComprehensiveLogViewer(
                        _comprehensiveLoggingService, 
                        _logger as ILogger<ComprehensiveLogViewer> ?? 
                        Microsoft.Extensions.Logging.Abstractions.NullLogger<ComprehensiveLogViewer>.Instance);
                    
                    logViewerWindow.Owner = this;
                    logViewerWindow.ShowDialog();
                }
                else
                {
                    MessageBox.Show("日志服务未初始化", "错误", MessageBoxButton.OK, MessageBoxImage.Warning);
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "❌ 打开全面日志查看器时发生错误");
                MessageBox.Show($"打开全面日志查看器失败: {ex.Message}", "错误", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        /// <summary>
        /// 在关闭窗口时释放日志服务资源
        /// </summary>
        protected override void OnClosing(CancelEventArgs e)
        {
            try
            {
                // 释放日志服务资源
                _comprehensiveLoggingService?.Dispose();
                _logger.LogInformation("✅ 全面日志管理服务已释放");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "❌ 释放日志服务资源时发生错误");
            }
            
            base.OnClosing(e);
        }
    }
}
#endregion