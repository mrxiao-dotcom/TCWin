                persistenceService.SaveContractConfigs(ContractMonitors.ToList());
                _logger.LogInformation("💾 合约配置已保存到文件");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "❌ 保存合约配置到文件失败");
            }
        }

        /// <summary>
