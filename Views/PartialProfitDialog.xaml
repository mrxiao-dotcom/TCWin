<Window x:Class="BinanceFuturesTrader.Views.PartialProfitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="分仓止盈设置" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="分仓止盈设置" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <!-- 持仓信息 -->
        <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="合约:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="SymbolText" FontWeight="Bold" Margin="0,0,20,5"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="方向:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Name="DirectionText" FontWeight="Bold" Margin="0,0,20,5"/>
                
                <TextBlock Grid.Row="0" Grid.Column="4" Text="数量:" FontWeight="Bold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Name="QuantityText" FontWeight="Bold" Margin="0,0,0,5"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="开仓价:" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Name="EntryPriceText" FontWeight="Bold" Margin="0,0,20,0"/>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Text="当前价:" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Name="CurrentPriceText" FontWeight="Bold" Margin="0,0,20,0"/>
                
                <TextBlock Grid.Row="1" Grid.Column="4" Text="当前浮盈:" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="5" Name="UnrealizedProfitText" FontWeight="Bold"/>
            </Grid>
        </materialDesign:Card>
        
        <!-- 分拆设置 -->
        <materialDesign:Card Grid.Row="2" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Vertical">
                <!-- 第一行：分拆数量设置 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="拆分数量:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Name="DecreaseSplitButton" Content="-" Click="DecreaseSplitButton_Click"
                            Width="30" Height="30" FontSize="16" FontWeight="Bold"
                            Background="Red" Foreground="White" Margin="0,0,5,0"/>
                    <TextBox Name="SplitCountTextBox" Width="80" Text="2" 
                             VerticalAlignment="Center" FontSize="14"
                             PreviewTextInput="SplitCountTextBox_PreviewTextInput"
                             TextChanged="SplitCountTextBox_TextChanged"/>
                    <Button Name="IncreaseSplitButton" Content="+" Click="IncreaseSplitButton_Click"
                            Width="30" Height="30" FontSize="16" FontWeight="Bold"
                            Background="Green" Foreground="White" Margin="5,0,10,0"/>
                    <TextBlock Text="（输入几则拆分成几单）" VerticalAlignment="Center" Margin="10,0,20,0" Foreground="Gray"/>
                    
                    <Button Name="RefreshSplitButton" Content="重新分配" Click="RefreshSplitButton_Click"
                            Background="LightBlue" Foreground="Black" Padding="10,5" Margin="10,0"/>
                </StackPanel>
                
                <!-- 第二行：目标浮盈快捷设置 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="目标浮盈快捷设置:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Name="Profit90Button" Content="90%" Click="ProfitRatioButton_Click" Tag="0.9"
                            Width="50" Height="25" FontSize="12" Margin="0,0,5,0"
                            Background="DarkGreen" Foreground="White"/>
                    <Button Name="Profit80Button" Content="80%" Click="ProfitRatioButton_Click" Tag="0.8"
                            Width="50" Height="25" FontSize="12" Margin="0,0,5,0"
                            Background="Green" Foreground="White"/>
                    <Button Name="Profit50Button" Content="50%" Click="ProfitRatioButton_Click" Tag="0.5"
                            Width="50" Height="25" FontSize="12" Margin="0,0,5,0"
                            Background="Orange" Foreground="White"/>
                    <Button Name="Profit10Button" Content="10%" Click="ProfitRatioButton_Click" Tag="0.1"
                            Width="50" Height="25" FontSize="12" Margin="0,0,5,0"
                            Background="Red" Foreground="White"/>
                    <TextBlock Text="（一键设置所有订单的目标浮盈比例）" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
        
        <!-- 分拆订单列表 -->
        <materialDesign:Card Grid.Row="3" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="分拆订单详情:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="SplitOrdersPanel"/>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>
        
        <!-- 计算结果 -->
        <materialDesign:Card Grid.Row="4" Padding="15" Margin="0,15,0,15" Background="LightYellow">
            <TextBlock Name="CalculationResultText" FontWeight="Bold" FontSize="12" 
                       Text="请设置分拆数量和目标浮盈，然后查看计算结果"
                       TextWrapping="Wrap"/>
        </materialDesign:Card>
        
        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="预览计算" Name="PreviewButton" Click="PreviewButton_Click"
                    Background="Orange" Foreground="White" FontWeight="Bold"
                    Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="确定执行" Name="ConfirmButton" Click="ConfirmButton_Click"
                    Background="Green" Foreground="White" FontWeight="Bold"
                    Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="取消" Name="CancelButton" Click="CancelButton_Click"
                    Background="Gray" Foreground="White"
                    Width="80" Height="35"/>
        </StackPanel>
    </Grid>
</Window> 