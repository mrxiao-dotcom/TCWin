<Window x:Class="BinanceFuturesTrader.Views.ContractConfigEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑合约配置" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
            <TextBlock Name="TitleTextBlock" Text="编辑合约配置" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- 编辑区域 -->
        <TabControl Grid.Row="1" Margin="15">
            <!-- 保本配置 -->
            <TabItem Header="💰 保本配置">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="合约名称：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Name="ContractNameText" Text="BTCUSDT" VerticalAlignment="Center" Margin="0,5" FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="当前浮盈：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="CurrentPnlText" Text="+125.50 USDT" VerticalAlignment="Center" Margin="0,5" FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="保本目标：" VerticalAlignment="Center" Margin="0,5"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <TextBox Name="BreakEvenTargetTextBox" Width="100" Text="100.00" Margin="0,0,5,0"/>
                        <TextBlock Text="USDT" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="保本状态：" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Name="BreakEvenStatusComboBox" Width="150" HorizontalAlignment="Left" Margin="0,5">
                        <ComboBoxItem Content="未触发" Tag="-" IsSelected="True"/>
                        <ComboBoxItem Content="已执行" Tag="√"/>
                    </ComboBox>
                </Grid>
            </TabItem>

            <!-- 推仓配置 -->
            <TabItem Header="📈 推仓配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="PushConfigPanel" Margin="15">
                        <!-- 动态生成的推仓档位控件将在这里添加 -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 保盈配置 -->
            <TabItem Header="🛡️ 保盈配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ProfitConfigPanel" Margin="15">
                        <!-- 动态生成的保盈档位控件将在这里添加 -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="SaveButton" Content="保存" Width="80" Height="30" 
                       Background="Green" Foreground="White" FontWeight="Bold" 
                       Click="SaveButton_Click" Margin="0,0,10,0"/>
                <Button Name="CancelButton" Content="取消" Width="80" Height="30" 
                       Background="Gray" Foreground="White" FontWeight="Bold" 
                       Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 