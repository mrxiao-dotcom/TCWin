<Window x:Class="BinanceFuturesTrader.Views.SimpleConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="基础配置编辑器" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧：配置列表 -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="📋 配置列表" FontSize="16" FontWeight="Bold" 
                          Margin="15,15,15,10" Foreground="#2C3E50"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,0,15,15">
                    <Button Name="NewConfigButton" Content="➕ 新增" Width="80" Height="35" 
                           Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="11"
                           Click="NewConfigButton_Click" Margin="0,0,5,0"/>
                    <Button Name="EditConfigButton" Content="✏️ 修改" Width="80" Height="35" 
                           Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="11"
                           Click="EditConfigButton_Click" Margin="0,0,5,0"/>
                    <Button Name="DeleteConfigButton" Content="🗑️ 删除" Width="80" Height="35" 
                           Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="11"
                           Click="DeleteConfigButton_Click"/>
                </StackPanel>
                
                <ListBox Grid.Row="2" Name="ConfigListBox" 
                         SelectionChanged="ConfigListBox_SelectionChanged"
                         Background="White" BorderThickness="1" BorderBrush="#BDC3C7"
                         Margin="15,0,15,15">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" 
                                   Padding="8,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" 
                                              FontSize="12" Foreground="#2C3E50"/>
                                    <TextBlock FontSize="9" Foreground="#7F8C8D" Margin="0,2,0,0">
                                        <Run Text="创建: "/>
                                        <Run Text="{Binding CreateTime, StringFormat='MM-dd HH:mm'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        
        <!-- 分隔线 -->
        <GridSplitter Grid.Column="1" Width="5" Background="#BDC3C7" HorizontalAlignment="Stretch"/>
        
        <!-- 右侧：配置明细 -->
        <Border Grid.Column="2" Background="White" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 风险金计算区域 -->
                    <Border Grid.Row="0" Background="#E8F5E8" BorderBrush="#27AE60" BorderThickness="2" 
                           CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="💰 风险金计算与自动填写" FontSize="14" FontWeight="Bold" 
                                      Foreground="#27AE60" Margin="0,0,0,10"/>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="账户权益：" VerticalAlignment="Center" 
                                          FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Name="AccountEquityTextBox" 
                                        IsReadOnly="True" Background="#F0F0F0" BorderBrush="#BDC3C7"
                                        Height="28" VerticalContentAlignment="Center" Padding="5,0"
                                        ToolTip="账户权益从系统配置自动获取，无需手动填写"/>
                                
                                <TextBlock Grid.Column="2" Text="风险次数：" VerticalAlignment="Center" 
                                          FontWeight="Bold" Margin="15,0,8,0"/>
                                <TextBox Grid.Column="3" Name="RiskTimesTextBox"
                                        IsReadOnly="True" Background="#F0F0F0" BorderBrush="#BDC3C7"
                                        Height="28" VerticalContentAlignment="Center" Padding="5,0"
                                        ToolTip="风险次数从系统配置自动获取，无需手动填写"/>
                                
                                <TextBlock Grid.Column="4" Text="单倍风险金：" VerticalAlignment="Center" 
                                          FontWeight="Bold" Margin="15,0,8,0"/>
                                <TextBox Grid.Column="5" Name="SingleRiskCapitalTextBox" 
                                        IsReadOnly="True" Background="#F0F0F0" BorderBrush="#BDC3C7"
                                        Height="28" VerticalContentAlignment="Center" Padding="5,0"/>
                                
                                <Button Grid.Column="6" Name="CalculateRiskCapitalButton" Content="🔄 刷新系统数据" 
                                       Width="130" Height="30" Background="#3498DB" Foreground="White" 
                                       FontWeight="Bold" FontSize="11" Margin="15,0,0,0"
                                       ToolTip="从系统重新获取最新的账户权益和风险次数"
                                       Click="CalculateRiskCapitalButton_Click"/>
                            </Grid>
                            
                            <TextBlock Grid.Row="2" Text="💡 账户权益和风险次数已从系统配置自动获取，计算公式：单倍风险金 = 账户权益 ÷ 风险次数" 
                                      FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                            
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button Name="AutoFillButton" Content="🎯 自动填写配置" 
                                       Width="150" Height="35" Background="#F39C12" Foreground="White" 
                                       FontWeight="Bold" FontSize="12" Margin="0,0,15,0"
                                       Click="AutoFillButton_Click"/>
                                <TextBlock Text="一键根据风险金自动填写：保本(0.1倍)、推仓(1-N倍)、止盈(10-N×10倍)" 
                                          VerticalAlignment="Center" FontSize="10" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 配置名称 -->
                    <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" 
                           CornerRadius="4" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="⚙️ 配置信息" FontSize="14" FontWeight="Bold" 
                                      Foreground="#2C3E50" Margin="0,0,0,10"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="配置名称：" VerticalAlignment="Center" 
                                      FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="ConfigNameTextBox" 
                                    IsReadOnly="True" Background="#F8F9FA" BorderBrush="#BDC3C7" Height="30"
                                    VerticalContentAlignment="Center" Padding="8,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Name="SaveConfigButton" Content="💾 保存" 
                                   Width="90" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="11"
                                   Click="SaveConfigButton_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    
                    <!-- 保本配置 -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#27AE60" BorderThickness="2" 
                           CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🛡️ 保本配置" FontSize="12" FontWeight="Bold" 
                                          Foreground="#27AE60" VerticalAlignment="Center"/>
                                <CheckBox Name="BreakEvenEnabledCheckBox" Content="启用保本" 
                                         Margin="15,0,0,0" VerticalAlignment="Center" IsEnabled="False"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Text="保本目标金额：当浮盈大于目标金额时，发送保本止损委托" 
                                      FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,8"/>
                            
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="目标金额：" VerticalAlignment="Center" 
                                          FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Name="BreakEvenAmountTextBox" 
                                        IsReadOnly="True" Background="#F8F9FA" BorderBrush="#BDC3C7" Height="28"
                                        VerticalContentAlignment="Center" Padding="6,0"/>
                                <TextBlock Grid.Column="2" Text="USDT" VerticalAlignment="Center" 
                                          Margin="8,0,0,0" FontWeight="Bold" Foreground="#27AE60"/>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- 推仓和保盈配置并排显示 -->
                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 推仓配置 -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#3498DB" BorderThickness="2" 
                               CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🚀 推仓配置" FontSize="13" FontWeight="Bold" 
                                              Foreground="#3498DB" VerticalAlignment="Center"/>
                                    <CheckBox Name="AddPositionEnabledCheckBox" Content="启用" 
                                             Margin="10,0,0,0" VerticalAlignment="Center" IsEnabled="False"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Name="AddTierButton" Content="➕ 增加" Width="85" Height="30" 
                                           Background="#3498DB" Foreground="White" FontSize="11" FontWeight="Bold"
                                           Click="AddTierButton_Click" Margin="0,0,5,0" Visibility="Collapsed"/>
                                    <Button Name="RemoveTierButton" Content="➖ 删除" Width="85" Height="30" 
                                           Background="#E74C3C" Foreground="White" FontSize="11" FontWeight="Bold"
                                           Click="RemoveTierButton_Click" Visibility="Collapsed"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="2" Text="阶梯推仓触发价和加仓数量控制，默认4个阶梯，可无限扩展" 
                                          FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <DataGrid Grid.Row="3" Name="AddPositionTiersDataGrid" 
                                         AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                         CanUserResizeColumns="True" IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                         Background="White" BorderBrush="#BDC3C7" FontSize="10" MinHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="阶梯" Binding="{Binding TierIndex}" Width="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="触发金额" Binding="{Binding TriggerProfitAmount, StringFormat=F2}" Width="90"/>
                                        <DataGridTextColumn Header="加仓倍数" Binding="{Binding RiskMultiplier, StringFormat=F1}" Width="80"/>
                                        <DataGridTextColumn Header="止损%" Binding="{Binding StopLossRatio, StringFormat=P1}" Width="70"/>
                                        <DataGridTextColumn Header="保盈金额" Binding="{Binding ProfitProtectionAmount, StringFormat=F0}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- 保盈配置 -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#F39C12" BorderThickness="2" 
                               CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="💰 保盈配置" FontSize="13" FontWeight="Bold" 
                                              Foreground="#F39C12" VerticalAlignment="Center"/>
                                    <CheckBox Name="ProfitProtectionEnabledCheckBox" Content="启用" 
                                             Margin="10,0,0,0" VerticalAlignment="Center" IsEnabled="False"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Name="AddProfitTierButton" Content="➕ 增加" Width="85" Height="30" 
                                           Background="#F39C12" Foreground="White" FontSize="11" FontWeight="Bold"
                                           Click="AddProfitTierButton_Click" Margin="0,0,5,0" Visibility="Collapsed"/>
                                    <Button Name="RemoveProfitTierButton" Content="➖ 删除" Width="85" Height="30" 
                                           Background="#E74C3C" Foreground="White" FontSize="11" FontWeight="Bold"
                                           Click="RemoveProfitTierButton_Click" Visibility="Collapsed"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="2" Text="当浮盈超过触发值后，根据对应阶梯生成保盈委托止损单，默认3个阶梯，可无限扩展" 
                                          FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <DataGrid Grid.Row="3" Name="ProfitProtectionTiersDataGrid" 
                                         AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                         CanUserResizeColumns="True" IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                         Background="White" BorderBrush="#BDC3C7" FontSize="10" MinHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="阶梯" Binding="{Binding TierIndex}" Width="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="触发金额" Binding="{Binding TriggerProfitAmount, StringFormat=F2}" Width="100"/>
                                        <DataGridTextColumn Header="保盈金额" Binding="{Binding ProtectionAmount, StringFormat=F2}" Width="100"/>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- 底部按钮 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Name="CancelButton" Content="❌ 取消" Width="90" Height="35" 
                               Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="11"
                               Click="CancelButton_Click" Margin="0,0,10,0"/>
                        <Button Name="CloseButton" Content="🚪 关闭" Width="90" Height="35" 
                               Background="#34495E" Foreground="White" FontWeight="Bold" FontSize="11"
                               Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window> 