<Window x:Class="BinanceFuturesTrader.Views.TriggerConditionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔧 编辑触发条件" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" Background="#4A90E2" CornerRadius="5" Padding="15,10" Margin="0,0,0,20">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- 合约信息 -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📊 合约信息" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="合约：" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ContractSymbol}" Margin="5,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="方向：" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding PositionSide}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 编辑区域 -->
        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="15" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🎯 触发条件编辑" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <!-- 条件列表 -->
                    <ItemsControl ItemsSource="{Binding TriggerConditions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9F9F9" CornerRadius="5" Padding="12" Margin="0,0,0,10" 
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- 条件基本信息 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Description}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6" 
                                                  Background="{Binding StatusColor}" VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- 触发价格编辑 -->
                                        <Grid Grid.Row="1" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="触发价格：" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Grid.Column="1" Text="{Binding TriggerPrice, StringFormat=F4}" 
                                                   Padding="5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2" Text="USDT" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" 
                                                     Foreground="{Binding StatusColor}"/>
                                        </Grid>
                                        
                                        <!-- 状态修改 -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="执行状态：" VerticalAlignment="Center" Width="80"/>
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding StatusIndex}" 
                                                    Padding="5" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <ComboBoxItem Content="未触发"/>
                                                <ComboBoxItem Content="执行中"/>
                                                <ComboBoxItem Content="已执行"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="2" Text="最后执行：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LastExecutionTimeText}" 
                                                     VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- 修改原因 -->
                    <StackPanel Margin="0,15,0,0">
                        <TextBlock Text="📝 修改原因（可选）" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ModificationReason}" AcceptsReturn="True" TextWrapping="Wrap" 
                               Height="60" Padding="8" VerticalScrollBarVisibility="Auto"
                               Background="#F9F9F9" BorderBrush="#E0E0E0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 按钮区域已移除 -->
    </Grid>
</Window> 