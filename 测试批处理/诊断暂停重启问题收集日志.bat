@echo off
chcp 65001 >nul
echo ============================
echo 🔍 诊断暂停重启问题日志收集
echo ============================

echo.
echo 📋 本脚本将指导您进行详细的问题诊断
echo 🔧 已大幅增强了启动过程的诊断日志系统
echo 📝 请按以下步骤操作并记录日志输出
echo.

echo ✅ 增强的诊断功能：
echo   • 配置验证详细日志
echo   • 事件总线启动过程跟踪
echo   • 持仓档案初始化诊断
echo   • 定时器创建状态监控
echo   • 服务状态实时检查
echo   • 基础配置验证后备方案
echo.

echo 🎯 诊断测试步骤：
echo.
echo === 第1步：准备工作 ===
echo 1. 启动TCWin应用程序
echo 2. 确保API配置正确（测试网或实盘）
echo 3. 打开应用程序的日志窗口或查看日志文件
echo 4. 准备记录详细的日志输出
echo.

echo === 第2步：基础配置测试 ===
echo 1. 进入"盯盘参数配置"
echo 2. 设置基本参数：
echo    • 配置名称：诊断测试
echo    • 扫描间隔：5秒
echo    • 启用保本或推仓（至少一个）
echo 3. 点击"保存配置"
echo 4. 观察配置保存是否成功
echo.

echo === 第3步：首次启动测试 ===
echo 1. 打开"自动盯盘监控面板"
echo 2. 点击"启动盯盘"按钮
echo 3. 仔细观察日志输出，记录以下信息：
echo    📝 配置验证阶段：
echo       • "🔍 开始验证配置..."
echo       • "📝 配置名称: XXX"
echo       • "⏱️ 扫描间隔: X秒"
echo       • "🔧 配置验证服务状态: XXX"
echo       • "✅ 配置验证服务调用成功" 或错误信息
echo.
echo    📝 事件总线启动阶段：
echo       • "🚌 开始启动事件总线..."
echo       • "🔧 事件总线状态: XXX"
echo       • "🔄 事件总线启动尝试 X/3"
echo       • "✅ 事件总线启动成功" 或错误信息
echo.
echo    📝 持仓档案初始化阶段：
echo       • "📊 开始初始化持仓档案..."
echo       • "🔧 Binance服务状态: XXX"
echo       • "💾 持久化服务状态: XXX"
echo       • "✅ 持仓档案初始化完成" 或错误信息
echo.
echo    📝 定时器创建阶段：
echo       • "⏰ 准备创建扫描定时器..."
echo       • "🔧 服务运行状态已设置为true"
echo       • "📝 定时器配置: 间隔 X秒"
echo       • "✅ 扫描定时器创建成功" 或错误信息
echo.
echo    📝 最终状态检查：
echo       • "🎉 自动监控服务启动完成！"
echo       • "🔧 最终服务状态检查"
echo       • "🚀 自动监控服务启动流程完成，返回true"
echo.

echo === 第4步：停止测试 ===
echo 1. 点击"停止盯盘"按钮
echo 2. 观察停止过程日志：
echo    • "⏹️ 自动监控正在停止..."
echo    • "⏰ 扫描定时器已完全停止"
echo    • "✅ 事件总线已停止"
echo    • "✅ 自动监控停止完成"
echo 3. 确认按钮状态变为"启动盯盘"
echo.

echo === 第5步：关键重启测试 ===
echo 1. 立即再次点击"启动盯盘"按钮
echo 2. 重点关注以下日志：
echo    📝 重启检测：
echo       • "🔄 等待服务状态完全重置..."
echo       • 重试逻辑相关日志
echo.
echo    📝 如果启动失败，记录：
echo       • "⚠️ 第X次启动返回false"
echo       • "🔧 服务状态诊断:" 下的所有信息
echo       • 重试过程和最终错误信息
echo.

echo === 第6步：多次重启压力测试 ===
echo 1. 进行5次连续的启动→停止→启动操作
echo 2. 每次操作间隔2-3秒
echo 3. 记录每次操作的成功率和日志
echo 4. 特别注意是否有累积问题
echo.

echo === 第7步：异常情况模拟 ===
echo 1. 在启动过程中断网3-5秒，然后恢复
echo 2. 观察重试机制是否正常工作
echo 3. 记录网络问题的诊断信息
echo.

echo 🔍 关键日志收集要点：
echo.
echo ❌ 如果出现启动失败，请特别记录：
echo   • 具体在哪个阶段失败（配置验证/事件总线/持仓初始化/定时器创建）
echo   • 失败时的详细错误信息
echo   • 服务状态诊断中显示的所有状态值
echo   • 是否触发了基础配置验证后备方案
echo   • 重试过程中的状态变化
echo.

echo ✅ 如果启动成功，请确认：
echo   • 所有阶段都有"✅"成功日志
echo   • 最终状态检查显示所有组件正常
echo   • 按钮状态正确显示"停止盯盘"
echo   • 倒计时正常运转
echo.

echo 🔧 新增的诊断特性：
echo   • 配置验证服务异常时自动切换到基础验证模式
echo   • 事件总线启动失败时的详细重试日志
echo   • 持仓初始化失败的智能原因分析
echo   • 定时器创建的详细状态跟踪
echo   • 服务最终状态的全面检查
echo.

echo 📋 问题分类指南：
echo.
echo 🔴 配置验证问题：
echo   • 看到"❌ 配置验证服务调用失败"
echo   • 或"⚠️ 切换到基础配置验证模式"
echo   • 可能是ConfigValidationService初始化问题
echo.

echo 🔴 事件总线问题：
echo   • 看到"❌ 事件总线启动失败"重复3次
echo   • 可能是系统资源或权限问题
echo.

echo 🔴 网络/API问题：
echo   • 看到"❌ 初始化持仓档案失败"
echo   • 包含timeout、unauthorized、rate等关键词
echo   • 可能是网络连接或API配置问题
echo.

echo 🔴 系统资源问题：
echo   • 看到"❌ 创建扫描定时器失败"
echo   • 可能是系统负载过高或权限限制
echo.

echo 🔴 状态管理问题：
echo   • 服务状态诊断显示不一致的状态
echo   • IsRunning和Config状态不匹配
echo   • 可能是并发访问或状态同步问题
echo.

echo 📞 报告问题时请提供：
echo   1. 完整的启动过程日志（从"🚀 启动自动监控服务..."开始）
echo   2. 服务状态诊断信息
echo   3. 重试过程中的状态变化
echo   4. 系统环境信息（.NET版本、Windows版本等）
echo   5. 网络环境描述（是否使用代理、VPN等）
echo.

echo 💡 临时解决方案：
echo   如果问题持续存在，可以尝试：
echo   1. 重启整个应用程序
echo   2. 检查Windows事件日志中的相关错误
echo   3. 临时降低扫描频率（增加间隔到10-15秒）
echo   4. 检查系统资源使用情况
echo.

echo ============================
echo 📊 诊断完成后请整理日志报告
echo ============================
pause 