@echo off
chcp 65001 >nul
echo.
echo ================================================================
echo 🔧 基础配置切换状态清理功能验证脚本
echo ================================================================
echo.
echo 📋 功能说明：
echo   当切换基础配置时，提供两种模式：
echo   1. 完全重新生成：删除所有旧状态数据，基于新配置重新生成
echo   2. 更新配置参数：保留执行状态，只更新配置参数
echo.
echo ================================================================
echo 🧪 测试步骤
echo ================================================================
echo.
echo **准备工作**
echo 1. 创建多个基础配置（不同的阶梯数量和金额）
echo 2. 启动自动盯盘，确保有一些执行状态
echo 3. 备份contract_monitoring_states.json文件
echo.
echo **测试步骤1：完全重新生成模式**
echo 1. 打开自动盯盘配置窗口
echo 2. 切换到另一个基础配置
echo 3. 在弹出的确认对话框中选择"是"
echo 4. 观察日志输出和状态文件变化
echo.
echo **预期结果1：**
echo ✅ 看到"🗑️ 步骤1：清理所有旧状态数据"日志
echo ✅ 看到"🔄 步骤2：基于新配置重新生成状态数据"日志
echo ✅ 状态文件中所有执行状态被重置为"未触发"
echo ✅ 触发金额更新为新配置的值
echo.
echo **测试步骤2：更新配置参数模式**
echo 1. 再次切换到另一个基础配置
echo 2. 在弹出的确认对话框中选择"否"
echo 3. 观察日志输出和状态文件变化
echo.
echo **预期结果2：**
echo ✅ 看到"保持现有执行状态，但更新基础配置参数"日志
echo ✅ 执行状态保持不变（如"已执行"状态保留）
echo ✅ 配置参数更新（金额、阶梯等）
echo.
echo ================================================================
echo 📊 详细验证指南
echo ================================================================
echo.
echo **验证点1：状态数据清理**
echo □ 日志显示：🗑️ 开始清理所有旧状态数据...
echo □ 日志显示：🧹 清理自动监控服务中的所有合约状态
echo □ 日志显示：🧹 清理统一状态文件中的所有数据
echo □ 日志显示：🧹 清理UI中的合约配置
echo □ 日志显示：✅ 所有旧状态数据清理完成
echo.
echo **验证点2：新状态数据生成**
echo □ 日志显示：🔄 步骤2：基于新配置重新生成状态数据
echo □ 日志显示：📊 找到 X 个活跃持仓
echo □ 日志显示：✅ 已生成统一监控状态文件：X 个活跃状态
echo □ 每个合约的配置名更新为新的基础配置名
echo.
echo **验证点3：文件内容检查**
echo 查看contract_monitoring_states.json文件：
echo □ 所有executionState为0（未触发）
echo □ 所有isExecuted为false
echo □ 所有executionTime为null
echo □ baseConfigName为新的配置名
echo □ triggerProfitAmount为新配置的金额
echo.
echo **验证点4：界面更新**
echo □ 自动盯盘配置窗口的数据表格列结构更新
echo □ 所有状态显示为"未触发"
echo □ 触发金额显示为新配置的值
echo □ 无旧的执行历史记录
echo.
echo ================================================================
echo 🔍 问题排查
echo ================================================================
echo.
echo **如果清理不完整**：
echo 1. 检查日志是否有错误信息
echo 2. 确认_autoMonitorService不为null
echo 3. 检查文件权限和访问权限
echo 4. 重启程序后再次尝试
echo.
echo **如果重新生成失败**：
echo 1. 确认有活跃持仓
echo 2. 检查基础配置是否有效
echo 3. 查看详细错误日志
echo 4. 确认网络连接正常（获取持仓信息）
echo.
echo ================================================================
echo 📋 使用场景
echo ================================================================
echo.
echo **选择"完全重新生成"的情况**：
echo • 配置差异很大（阶梯数量变化、金额大幅调整）
echo • 想重新开始，清除所有执行历史
echo • 测试新配置的效果
echo • 解决状态数据混乱问题
echo.
echo **选择"更新配置参数"的情况**：
echo • 只是微调金额或其他参数
echo • 希望保留执行历史和状态
echo • 连续性策略调整
echo • 避免重复触发已执行的操作
echo.
echo ================================================================
echo 🚨 注意事项
echo ================================================================
echo.
echo 1. **数据备份**：切换前建议备份状态文件
echo 2. **执行时机**：建议在市场相对平静时进行切换
echo 3. **监控影响**：完全重新生成会重置所有执行状态
echo 4. **日志监控**：密切关注切换过程的日志输出
echo 5. **验证配置**：切换后验证新配置是否按预期工作
echo.
echo 按任意键继续...
pause >nul 