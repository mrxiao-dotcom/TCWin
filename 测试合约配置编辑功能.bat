echo   5. 在弹出的编辑对话框中测试各种功能
echo.
echo 🎯 编辑对话框功能测试：
echo   ┌─────────────────────────────────────────────────┐
echo   │ 📊 合约基本信息                                 │
echo   │   • 显示合约代码、方向、价格、仓位、盈亏        │
echo   │   • 合约启用/禁用状态                           │
echo   └─────────────────────────────────────────────────┘
echo.
echo   ┌─────────────────────────────────────────────────┐
echo   │ 🎯 触发条件配置                                 │
echo   │   🛡️ 保本条件：                                │
echo   │     • 修改触发金额（如：从50改为100）          │
echo   │     • 重置执行状态                              │
echo   │                                                │
echo   │   📈 推仓条件（如有多档）：                     │
echo   │     • 修改每档的触发金额                        │
