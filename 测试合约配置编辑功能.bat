echo   • 保盈金额只对止盈条件有效
echo.
echo 🐛 问题排查：
echo   • 如果编辑按钮无响应：检查监控是否已停止
echo   • 如果对话框打开失败：检查日志文件
echo   • 如果修改不生效：检查配置文件权限
