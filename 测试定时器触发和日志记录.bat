@echo off
chcp 65001 > nul
echo.
echo ==========================================
echo         定时器触发和日志记录测试
echo ==========================================
echo.

echo 🔧 测试目标：验证定时器是否正常触发扫描
echo.
echo 📋 测试步骤：
echo    1. 启动自动盯盘
echo    2. 观察工作日志区域
echo    3. 验证定时器触发日志
echo    4. 检查扫描状态
echo.

echo 🔍 需要观察的日志关键词：
echo    ✅ "自动盯盘系统已启动"
echo    ✅ "定时器已启动，下次扫描: xx:xx:xx"
echo    ✅ "系统开始工作: xx:xx:xx"
echo    ✅ "定时器触发，开始扫描"
echo    ✅ "状态检查通过，开始扫描"
echo.

echo 🚨 如果出现以下日志，说明有问题：
echo    ❌ "扫描被跳过: 服务未运行"
echo    ❌ "扫描被跳过: 配置为空"
echo    ❌ "创建扫描定时器失败"
echo.

echo 📊 测试预期结果：
echo    • 启动后立即显示"自动盯盘系统已启动"
echo    • 每隔配置的扫描间隔（如5秒）显示"定时器触发，开始扫描"
echo    • 如果有持仓，会显示"开始处理 X 个活跃持仓"
echo    • 如果无持仓，会显示"当前无活跃持仓，继续等待新持仓"
echo.

echo 🔧 诊断建议：
echo    如果定时器不触发，请检查：
echo    1. 系统是否正确启动（看到"自动盯盘系统已启动"）
echo    2. 配置是否正确加载（看到配置名称）
echo    3. 定时器是否创建成功（看到"定时器已启动"）
echo.

echo 💡 测试提示：
echo    • 清空工作日志后开始测试，便于观察
echo    • 建议将扫描间隔设置为5秒便于测试
echo    • 保持程序运行至少1分钟观察定时器触发
echo.

echo 按任意键关闭此窗口...
pause > nul 