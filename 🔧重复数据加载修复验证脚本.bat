@echo off
chcp 65001 >nul
echo.
echo ===============================================
echo 🔧 重复数据加载修复验证脚本
echo ===============================================
echo.
echo 📋 验证目标：
echo    解决自动盯盘面板关闭后重新打开时持仓数据重复的问题
echo.
echo 🎯 修复说明：
echo    问题：每次打开面板时，窗口Loaded事件重复加载数据
echo    修复：添加数据量检查，只有UI无数据时才加载
echo.
echo ===============================================
echo 🧪 测试步骤
echo ===============================================
echo.
echo 【第一步：基础测试】
echo 1. 启动程序，选择账户
echo 2. 点击【启动盯盘】打开自动盯盘面板
echo 3. 观察持仓数据加载情况
echo 4. 记录当前显示的持仓数量：_____个
echo.
echo 【第二步：重复测试】
echo 1. 关闭自动盯盘面板
echo 2. 再次点击【启动盯盘】打开面板
echo 3. 观察是否出现重复的持仓记录
echo 4. 验证持仓数量是否与第一次相同：_____个
echo.
echo 【第三步：日志验证】
echo 1. 在第二次打开时，观察日志区域
echo 2. 查看是否出现以下关键日志：
echo    - "【重复检查】当前UI已有 X 个配置"
echo    - "【重复预防】UI已有数据，跳过重复加载"
echo.
echo ===============================================
echo ✅ 预期结果
echo ===============================================
echo.
echo 🎯 成功标志：
echo □ 第一次打开：正常显示持仓数据
echo □ 第二次打开：持仓数量与第一次完全相同
echo □ 无重复记录：没有相同的合约显示两次
echo □ 日志正确：显示"跳过重复加载"消息
echo.
echo 🚫 失败标志：
echo □ 持仓数据翻倍（如原来2个变成4个）
echo □ 相同合约出现多次
echo □ 日志显示重复加载数据
echo.
echo ===============================================
echo 🔧 如果仍有问题
echo ===============================================
echo.
echo 问题1：仍然出现重复数据
echo 解决：检查构造函数中的LoadInitialDataAsync调用
echo.
echo 问题2：第二次打开无数据
echo 解决：检查数据清空逻辑是否过度清理
echo.
echo 问题3：数据不同步
echo 解决：检查文件读写权限和路径
echo.
echo ===============================================
echo 💡 技术细节
echo ===============================================
echo.
echo 修复位置：Views/AutoMonitorConfigWindowSimple.xaml.cs
echo 修复方法：AutoMonitorConfigWindow_Loaded 事件
echo.
echo 关键逻辑：
echo 1. 检查当前UI数据量：ContractConfigs.Count
echo 2. 只有数量为0时才调用LoadExistingContractConfigsAsync
echo 3. 有数据时跳过加载，避免重复
echo.
echo ===============================================
echo 📊 测试记录表
echo ===============================================
